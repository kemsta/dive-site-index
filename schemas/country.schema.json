{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kemsta.github.io/dive-site-index/schemas/country.schema.json",
  "title": "Country catalog node",
  "type": "object",
  "required": ["schema_version", "id", "iso_alpha2", "names", "default_locale"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
    "iso_alpha2": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "names": {"$ref": "#/$defs/localizedStrings"},
    "default_locale": {"type": "string"}
  },
  "$defs": {
    "localizedStrings": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {"^.+$": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
